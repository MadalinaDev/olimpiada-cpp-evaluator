  "testCases": [
    {
      "id": 1,
      "name": "Test 1",
      "description": "Exemplul din enunt",
      "input": "-1 2\n2 1\n6 -4\n4 6\n20\n",
      "expectedOutput": "23.50\n930.00"
    },
    {
      "id": 2,
      "name": "Test 2",
      "description": "Patrat aliniat la axe - lotul umple dreptunghiul",
